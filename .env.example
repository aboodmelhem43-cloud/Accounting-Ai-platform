# قاعدة البيانات — PostgreSQL عبر Neon أو Supabase
DATABASE_URL="postgresql://user:password@host:5432/accounting_db?sslmode=require"

# NextAuth — يجب توليده بـ: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Password reset HMAC secret — separate from NEXTAUTH_SECRET so rotating one doesn't affect the other
# Generate with: openssl rand -base64 32
PASSWORD_RESET_SECRET="generate-a-strong-secret-here"

# Anthropic Claude API
ANTHROPIC_API_KEY="sk-ant-..."

# مسار رفع الملفات (محلي في التطوير)
UPLOAD_DIR="public/uploads"

# Resend — إرسال البريد الإلكتروني
RESEND_API_KEY="re_..."
FROM_EMAIL="noreply@mohasabai.com"
SUPPORT_EMAIL="support@mohasabai.com"

# Lemon Squeezy — بوابة الدفع
LEMONSQUEEZY_API_KEY="eyJ0eXAiOiJKV1Qi..."
LEMONSQUEEZY_STORE_ID="12345"
LEMONSQUEEZY_WEBHOOK_SECRET="your-webhook-secret"
LEMONSQUEEZY_VARIANT_STARTER="111111"
LEMONSQUEEZY_VARIANT_PRO="222222"
LEMONSQUEEZY_VARIANT_BUSINESS="333333"
LEMONSQUEEZY_VARIANT_STARTER_YEARLY="444444"
LEMONSQUEEZY_VARIANT_PRO_YEARLY="555555"
LEMONSQUEEZY_VARIANT_BUSINESS_YEARLY="666666"

# URL العام للتطبيق (بدون trailing slash)
NEXT_PUBLIC_APP_URL="https://mohasabai.com"

# Super-admin emails (comma-separated) — can access /admin to see all businesses
SUPER_ADMIN_EMAILS="admin@yourdomain.com"

# Admin secret for one-time tools (e.g. extend-trials) — generate with: openssl rand -base64 32
ADMIN_SECRET="generate-a-strong-secret-here"

{
  "expo": {
    "name": "محاسب AI",
    "slug": "mohasabai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "mohasabai",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1D4ED8"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.mohasabai.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "لالتقاط صور الفواتير وتحليلها بالذكاء الاصطناعي",
        "NSPhotoLibraryUsageDescription": "لاختيار صور الفواتير من المكتبة",
        "NSPhotoLibraryAddUsageDescription": "لحفظ المستندات"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1D4ED8"
      },
      "package": "com.mohasabai.app",
      "versionCode": 1,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        { "cameraPermission": "لالتقاط صور الفواتير وتحليلها بالذكاء الاصطناعي" }
      ],
      [
        "expo-image-picker",
        { "photosPermission": "لاختيار صور الفواتير من مكتبة الصور" }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "REPLACE_WITH_EAS_PROJECT_ID"
      }
    }
  }
}
